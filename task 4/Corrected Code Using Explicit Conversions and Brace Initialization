#include <iostream>
using namespace std;
int main() {
    int a{7};
    int b{2};
    // Explicit conversion after integer division
    double c{static_cast<double>(a / b)};
    // Explicit conversion before division
    double d{
        static_cast<double>(a) /
        static_cast<double>(b)
    };
    cout << c << ' ' << d << '\n';
    // Explicit conversion to char
    char ch{static_cast<char>('A' + 2)};
    cout << ch << ' '
         << static_cast<int>(ch) + 1 << '\n';
    // Explicit conversion from int to bool
    bool flag{static_cast<bool>(5)};
    cout << static_cast<int>(flag) << ' '
         << boolalpha << flag << '\n';
    unsigned int u{1};
    int s{-1};
    // Check negative values before unsigned conversion
    if (s < 0) {
        cout << "s >= u" << '\n';
    }
    else if (static_cast<unsigned int>(s) < u) {
        cout << "s < u" << '\n';
    }
    else {
        cout << "s >= u" << '\n';
    }
    return 0;
}
