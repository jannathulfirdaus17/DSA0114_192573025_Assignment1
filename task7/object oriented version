#include <iostream>
using namespace std;
class SmartCard {
private:
    long long balance;
    static constexpr long long MIN_BALANCE = 5000;
public:
    SmartCard(long long initialBalance) {
        balance = (initialBalance >= MIN_BALANCE ? initialBalance : MIN_BALANCE;
    }
    bool canTravel(long long fare) const {
        return fare >= 0 && balance - fare >= MIN_BALANCE;
    }
    bool deduct(long long fare) {
        if (canTravel(fare)) {
            balance -= fare;
            return true;
        }
        return false;
    }
    long long getBalance() const {
        return balance;
    }
};
int main()
{
    SmartCard card(10000);
    long long fare = 3000;
    if (card.deduct(fare))
        cout << "Journey allowed\n";
    else
        cout << "Journey denied\n";

    cout << "Remaining balance: "
         << card.getBalance() << " paise";
    return 0;
}
