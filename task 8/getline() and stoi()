#include <iostream>
#include <string>
using namespace std;
int main()
{
    string input;
    int zone;
    cout << "Enter zone (1-3): ";
    getline(cin, input);
    try {
        size_t pos;
        zone = stoi(input, &pos);
        if (pos != input.length() || zone < 1 || zone > 3)
            throw invalid_argument("Invalid zone");
        cout << "Valid zone: " << zone;
    }
    catch (const exception&) {
        cout << "Invalid input";
    }
    return 0;
}
