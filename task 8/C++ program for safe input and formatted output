#include <iostream>
#include <iomanip>
#include <limits>
using namespace std;
int main()
{
    int zone;
    long long fare = 1000;
    cout << "Enter zone (1-3): ";
    while (!(cin >> zone) || zone < 1 || zone > 3) {
        cout << "Invalid input. Enter zone (1-3): ";
        if (cin.fail()) {
            cin.clear();
            cin.ignore(numeric_limits<streamsize>::max(), '\n');
        }
    }
    if (zone == 1)
        fare = 1000;
    else if (zone == 2)
        fare = 2000;
    else
       fare = 3000;
    cout << "\n----- Journey Report -----\n";
    cout << "Zone: " << zone << '\n';
    cout << "Fare: Rs "
         << fixed << setprecision(2)
         << fare / 100.0 << '\n';

    cout << "--------------------------\n";
    return 0;
}
