#include <iostream>
using namespace std;
int main() {
    bool peak[24] = {};
    // Morning peak: 8 AM to 9:59 AM
    for (int i = 8; i < 10; i++) {
        peak[i] = true;
    }
    // Evening peak: 5 PM to 7:59 PM
    for (int i = 17; i < 20; i++) {
        peak[i] = true;
    }
    int hour = 9;
    if (hour >= 0 && hour < 24 && peak[hour]) {
        cout << "Peak hour";
    }
    else {
        cout << "Non-peak hour";
    }
    return 0;
}
