#include <iostream>
#include <iomanip>
#include <sstream>
#include <string>
using namespace std;
const long long MIN_BALANCE = 5000;
const int BASE_FARE[] = {1000, 2000, 3000};
bool isPeak(int hour)
{
    return (hour >= 8 && hour < 10) ||
           (hour >= 17 && hour < 20);
}
long long calculateFare(int zone, int hour)
{
    if (zone < 1 || zone > 3 || hour < 0 || hour > 23)
        return -1;

    long long fare = BASE_FARE[zone - 1];
    if (isPeak(hour))
        fare += fare * 20 / 100;
    return fare;
}
bool canTravel(long long balance, long long fare)
{
    return fare >= 0 && balance - fare >= MIN_BALANCE;
}
bool recharge(long long &balance, long long amount)
{
    if (amount < 0)
        return false;
    balance += amount;
    return true;
}
int main()
{
    cout << fixed << setprecision(2);
    cout << "----- Fare Test Results -----\n";
    int zones[] = {1, 2, 3, 1, 2, 3};
    int hours[] = {12, 12, 12, 8, 10, 17};
    for (int i = 0; i < 6; i++) {
        long long fare = calculateFare(zones[i], hours[i]);
        cout << "Zone " << zones[i]
             << ", Hour " << hours[i]
             << " : ";

        if (fare == -1)
            cout << "Invalid journey\n";
        else
            cout << "Rs " << fare / 100.0 << '\n';
    }
    cout << "\n----- Boundary Tests -----\n";
    int boundaryHours[] = {8, 10, 17, 20};
    for (int hour : boundaryHours) {
        cout << hour << ":00 - "
             << (isPeak(hour) ? "Peak" : "Off-peak") << '\n';
    }
    cout << "\n----- Balance Test -----\n";
    cout << boolalpha
         << "Exactly Rs 50 remaining: "
         << canTravel(15000, 10000) << '\n';
    cout << "\n----- Invalid Tests -----\n";
    cout << "Unknown zone: "
         << (calculateFare(4, 12) == -1) << '\n';
    long long balance = 10000;
    cout << "Negative recharge accepted: "
         << recharge(balance, -500) << '\n';
    string input = "abc";
    istringstream inputStream(input);
    int hour;
    cout << "Letters entered for hour: "
         << !(inputStream >> hour) << '\n';
    cout << "\n----- Five Journey Total -----\n";
    int testZones[] = {1, 2, 3, 1, 2};
    int testHours[] = {12, 8, 12, 17, 12};

    long long total = 0;
    for (int i = 0; i < 5; i++) {
        long long fare = calculateFare(testZones[i], testHours[i]);
        total += fare;
        cout << "Journey " << i + 1
             << ": Rs " << fare / 100.0 << '\n';
    }
    cout << "Total fare: Rs " << total / 100.0 << '\n'; 
    return 0;
}
